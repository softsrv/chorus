# Application
APP_ENV=development          # "development" or "production"
PORT=8080
# Public URL of the web client; used to build links in emails.
APP_BASE_URL=http://localhost:8080
# Number of trusted reverse-proxy hops in front of the app (0 = exposed directly).
# Controls whether X-Forwarded-For is trusted for rate limiting.
TRUSTED_PROXY_COUNT=0

# Database (docker compose exposes Postgres on 5433)
DATABASE_URL=postgres://chorus:chorus@localhost:5433/chorus?sslmode=disable
TEST_DATABASE_URL=postgres://chorus:chorus@localhost:5433/chorus_test?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=<at-least-32-bytes-of-random-secret-here>
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=720h

# Passwords
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8

# SMTP (required for email verification and password reset)
# Local dev: docker compose runs smtp4dev (SMTP on :2525, web UI on http://localhost:5080)
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@chorus.local
SMTP_FROM_NAME=Chorus
